# ─────────────────────────────────────────────────────────────────────────────
# Noboru Prospector — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Secrets live only in .env.local (locally) and Vercel env vars (deployed).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Phase 1) ───────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets one-way sync (Phase 1) ─────────────────────────────────────
# Service-account JSON key, base64-encoded in one line:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# The spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Protects the nightly re-sync cron endpoint (set the same value in Vercel).
# Any long random string: openssl rand -hex 32
CRON_SECRET=

# ── Phase 2+ (leave empty for now) ───────────────────────────────────────────
# Anthropic API — research engine (Phase 2)
ANTHROPIC_API_KEY=
# Enrichment adapter (Phase 3): lusha | apollo
ENRICHMENT_PROVIDER=
LUSHA_API_KEY=
APOLLO_API_KEY=
